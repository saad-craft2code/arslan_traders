# ====================================================================
# Arslan Traders - Office Furniture Store
# Environment variables for Vercel deployment
# ====================================================================
# Copy this file to .env for local development.
# On Vercel, set these in: Project Settings → Environment Variables
# ====================================================================

# REQUIRED: PostgreSQL connection string (Neon, Supabase, or any Postgres provider)
# Get this from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# OPTIONAL: Site URL for SEO canonical URLs (set this to your Vercel domain after deploy)
# Default is https://arslantraders.pk - update in src/app/layout.tsx if you have a custom domain
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
